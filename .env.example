# ProjectFrontier local LLM settings. Read by the Unity Editor only (FrontierLlmManager).
# Real environment variables override these. Never commit a filled-in copy; .env is git-ignored.
# See docs/LLM_SETUP.md.

# Offline | DirectDev | Proxy
FRONTIER_LLM_MODE=DirectDev
# Any OpenAI-compatible endpoint ending in /v1 (OpenAI, Groq, OpenRouter, DeepSeek, llama.cpp, LM Studio, Ollama...)
FRONTIER_LLM_BASE_URL=https://api.openai.com/v1
FRONTIER_LLM_MODEL=gpt-4o-mini
# Paste your key after the = sign. Leave blank to stay on offline replies.
FRONTIER_LLM_API_KEY=
