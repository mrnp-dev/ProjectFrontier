  m_Script: {fileID: 11500000, guid: 9b851f6b7e8686c978d20b651fb192a6, type: 3}
  m_Name: Bram
  m_EditorClassIdentifier: Assembly-CSharp::ProjectFrontier.NpcPersona
  npcId: bram
  displayName: Bram
  roleTitle: Blacksmith
  homeSpot: 0
  gameplayTieIn: Weapon and armor forging; dungeon-ore upgrades.
  personality: Proud, blunt craftsman. Takes any slight to his work personally; fiercely
    loyal once you earn his respect.
  speechStyle: Short, gruff sentences. Forge and iron metaphors. Never says please.
  hooks:
  - Mocking his craft becomes a grudge he spreads
  - Wants rare dungeon ore for a masterpiece blade
  - Trusts Mira; thinks Lyra is reckless
  greetingLines:
  - Hmph. Another newcomer. Mind the sparks.
  - Lanterns dying already? Fetch the shards. Iron and fire wait for no one.
